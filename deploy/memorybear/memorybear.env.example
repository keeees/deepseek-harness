# MemoryBear service overrides, installed to /etc/memorybear/memorybear.env.
#
# Applied on top of the unit's own defaults, so only uncomment what you want to
# change. Run `sudo systemctl restart memorybear` after editing. The installer
# never overwrites this file once it exists, so local changes survive a re-run.
#
# Nothing here needs editing to move this deployment to another machine or
# network: the reachable address is derived at each start, and nginx accepts any
# Host. This file is for deliberate changes only.

# Listen address and port of the app itself. Loopback is not a hardening choice
# that can be relaxed -- the browser client mints ids with crypto.randomUUID(),
# which exists only in a secure context, so a plain-HTTP LAN origin loads the
# shell and then fails on the first request. Publishing this port would only
# advertise a broken address; nginx on 443 is the way in.
#MB_HOST=127.0.0.1
#MB_PORT=3081

# Launcher overlays, in order. Drop the local-vllm entry to stop using this
# machine's own model server and go back to a hosted model, which then needs a
# credential below.
#MB_PATCHES=--patch deploy/memorybear/brand.patch.yml --patch deploy/memorybear/local-vllm.patch.yml --patch deploy/memorybear/chat-only.patch.yml

# Extra CLI arguments. Not needed for addressing any more: nginx presents every
# request to the app as loopback, so the browser-trust fence has nothing to
# refuse and no --trusted-host list has to be maintained. Restore that fence by
# removing the Host/Origin rewrite from the nginx site and declaring authorities
# here instead:
#   MB_EXTRA_ARGS=--trusted-host 192.168.1.50 myhost localhost
# `deploy/memorybear/local-authorities.sh trusted` prints the list this machine
# would declare.
#MB_EXTRA_ARGS=

# Model credential, only needed for a hosted route. The default model is this
# machine's own vLLM, which needs none. The web UI's Models page is the preferred
# route for a key; it stores one under $DSH_HOME/.credentials.yaml. Note that a
# value set here outranks that store.
#DEEPSEEK_API_KEY=
